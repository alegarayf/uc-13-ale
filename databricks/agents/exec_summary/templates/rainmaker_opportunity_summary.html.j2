<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ rainmaker.metadata.company_name | default('Company', true) }} — Opportunity Summary</title>
<style>
  @page { size: A4 landscape; margin: 12mm 14mm 14mm 14mm; }
  * { box-sizing: border-box; }
  body {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    color: #1A1A1A;
    font-size: 8.5pt;
    line-height: 1.2;
    margin: 0;
  }
  .page { page-break-after: always; padding-bottom: 6mm; }
  .page:last-child { page-break-after: auto; }
  h1 { color: #1F3864; font-size: 18pt; margin: 0 0 1mm 0; text-transform: uppercase; }
  .eyebrow { color: #C2600D; font-weight: bold; font-size: 8.5pt; letter-spacing: 0.06em; text-transform: uppercase; }
  h2.section-header {
    color: #1F3864; font-size: 13pt; margin: 0 0 1mm 0;
  }
  h3.block-header {
    color: #FFFFFF; font-size: 8pt; letter-spacing: 0.03em;
    text-transform: uppercase; padding: 1mm 2.5mm; margin: 0 0 1.5mm 0;
    background: #1F3864;
  }
  h3.block-header.watchouts { background: #C2600D; }
  .subtitle { color: #595959; font-size: 9pt; margin-bottom: 2mm; }
  .logo-row { display: flex; justify-content: space-between; align-items: flex-start; }
  .logo-row img { max-height: 9mm; }
  .divider { border-top: 2pt solid #1F3864; border-bottom: 0; margin: 2mm 0 3mm 0; }
  .doc-header h1 { margin: 0 0 0.5mm 0; }
  .doc-header .subtitle { margin-bottom: 1.5mm; }
  .running-header {
    display: flex; justify-content: space-between; align-items: baseline;
    color: #595959; font-size: 7.5pt; text-transform: uppercase; letter-spacing: 0.03em;
    border-bottom: 0.5pt solid #BFD0E8; padding-bottom: 1.5mm; margin-bottom: 3mm;
  }
  .running-header .company { color: #1F3864; font-weight: bold; }
  .footer {
    color: #595959; font-size: 7pt;
    border-top: 0.5pt solid #BFD0E8; padding-top: 1.5mm; margin-top: 3mm;
  }
  .footer .disclosure { display: block; margin-top: 1mm; }
  .one-liner {
    background: #F2F4F7; border-left: 3pt solid #1F3864;
    padding: 2mm 3.5mm; font-style: italic; margin: 2mm 0 3mm 0;
  }
  .one-liner .core-line { margin-bottom: 0.8mm; }
  .one-liner .core-line:last-child { margin-bottom: 0; }
  .recommendation {
    background: #FCEEE0; border-left: 3pt solid #C2600D;
    padding: 2mm 3.5mm; margin: 3mm 0; font-weight: bold;
  }
  ul.bullets { margin: 0 0 2mm 0; padding-left: 4mm; }
  ul.bullets li { margin-bottom: 0.6mm; }
  .grid-2 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 3mm; margin-bottom: 2.5mm; }
  .card {
    background: #fff; border: 0.5pt solid #BFD0E8;
    border-radius: 1.5mm; overflow: hidden;
  }
  .card-body { padding: 0 2.5mm 2.5mm 2.5mm; }
  table.data-table { width: 100%; table-layout: fixed; border-collapse: collapse; margin: 2mm 0 4mm 0; }
  table.data-table th, table.data-table td {
    border-bottom: 0.5pt solid #BFD0E8; padding: 1.3mm 2mm; text-align: right; vertical-align: top;
    font-size: 8.3pt; overflow: hidden;
  }
  table.data-table th:first-child, table.data-table td:first-child { text-align: left; }
  table.data-table th { color: #fff; background: #1F3864; font-size: 7.5pt; text-transform: uppercase; }
  table.data-table tr.highlight td { background: #EEF3FA; font-weight: bold; }
  table.data-table td.growth-col { background: #EEF3FA; font-weight: bold; color: #1F3864; }
  table.data-table th.growth-col { background: #17284c; color: #fff; }
  .tile-row { display: flex; gap: 3mm; margin: 3mm 0 5mm 0; flex-wrap: wrap; }
  .tile-row-secondary { margin-top: 0; }
  .tile-row-secondary .tile { padding: 2mm; }
  .tile-row-secondary .value { font-size: 12pt; }
  .tile {
    flex: 1 1 26mm; background: #F2F4F7; border: 0.5pt solid #BFD0E8;
    border-radius: 2mm; padding: 3mm; text-align: center;
  }
  .tile .value { color: #1F3864; font-size: 15pt; font-weight: bold; display: block; }
  .tile .label { color: #595959; font-size: 7.5pt; text-transform: uppercase; letter-spacing: 0.02em; }
  .rule-band { display: flex; gap: 4mm; margin: 3mm 0 5mm 0; }
  .rule-band-tile {
    flex: 1 1 40mm; background: #F2F4F7; border: 1pt solid #595959;
    border-radius: 2mm; padding: 3mm 4mm; text-align: center;
  }
  .rule-band-tile.above { border-color: #1F3864; }
  .rule-band-tile .value { color: #1F3864; font-size: 26pt; font-weight: bold; display: block; }
  .rule-band-tile.below .value { color: #595959; }
  .rule-band-tile .components { display: block; color: #1A1A1A; font-size: 8.5pt; margin-top: 0.5mm; }
  .rule-band-tile .label { color: #595959; font-size: 7.5pt; text-transform: uppercase; letter-spacing: 0.02em; }
  .two-col { display: flex; gap: 10mm; }
  .two-col > div { flex: 1; }
  .page.mps { page-break-inside: avoid; }
  table.mps-table { width: 100%; table-layout: fixed; border-collapse: collapse; margin: 1.5mm 0 1.5mm 0; }
  table.mps-table th, table.mps-table td {
    border-bottom: 0.5pt solid #BFD0E8; padding: 0.8mm 2mm; text-align: left; vertical-align: top;
    font-size: 7.3pt; line-height: 1.1; overflow: hidden;
  }
  table.mps-table th { color: #fff; background: #1F3864; font-size: 7pt; text-transform: uppercase; }
  table.mps-table th.mps-category-col, table.mps-table td.mps-category-col { background: #1F3864; color: #fff; font-weight: bold; }
  table.mps-table tr { page-break-inside: avoid; }
  table.mps-table td.mps-score-col { text-align: center; font-size: 12pt; font-weight: bold; color: #1F3864; }
  table.mps-table td.mps-commentary-col ul.bullets { margin: 0; padding-left: 3mm; }
  table.mps-table td.mps-commentary-col li { margin-bottom: 0.3mm; }
  table.mps-table li.mps-counter-evidence { color: #595959; font-style: italic; }
  table.mps-table tr.mps-total-row td { border-bottom: none; border-top: 1pt solid #1F3864; }
  table.mps-table tr.mps-total-row td.mps-score-col { font-size: 12pt; }
  .mps-legend { color: #595959; font-size: 7pt; margin: 0 0 1mm 0; }
  .mps-footer-note { color: #1F3864; font-weight: bold; font-size: 9pt; margin-top: 1mm; }
</style>
</head>
<body>

<!-- Page 1 — Company & Investment Framing (no separate cover page) -->
<section class="page framing">
  <div class="doc-header">
    <div class="logo-row">
      <div>
        <h1>{{ rainmaker.metadata.company_name | default('Company', true) }}</h1>
        <div class="subtitle">
          Business Opportunity Summary &nbsp;·&nbsp; First-Pass Investment Screen
          {% if rainmaker.metadata.date %}&nbsp;·&nbsp;{{ rainmaker.metadata.date }}{% endif %}
        </div>
      </div>
      {% if brand_logo_data_uri %}<img src="{{ brand_logo_data_uri }}" alt="Rallyday Partners">{% endif %}
    </div>
    <div class="divider"></div>
  </div>

  <div class="eyebrow">Company &amp; Investment Framing</div>
  <h2 class="section-header">What the business is &amp; why it could be interesting</h2>
  <div class="divider"></div>

  {% if narrative and narrative.core_business %}
  <div class="one-liner">
    {% for line in narrative.core_business[:3] %}<div class="core-line">{{ line }}</div>{% endfor %}
  </div>
  {% elif narrative and narrative.one_liner %}
  <div class="one-liner">{{ narrative.one_liner }}</div>
  {% elif bundle.executive.in_one_line %}
  <div class="one-liner">{{ bundle.executive.in_one_line }}</div>
  {% endif %}

  <div class="grid-2">
    <div class="card">
      <h3 class="block-header">Company Overview</h3>
      <div class="card-body">
        <ul class="bullets">
          {% for bullet in (narrative.company_overview if (narrative and narrative.company_overview) else (bundle.company_framing.overview_bullets or []))[:4] %}
          <li>{{ bullet }}</li>
          {% else %}
          <li>Not yet assessed in this preview.</li>
          {% endfor %}
        </ul>
      </div>
    </div>

    <div class="card">
      <h3 class="block-header">Product &amp; Revenue Model</h3>
      <div class="card-body">
        <ul class="bullets">
          {% if narrative and narrative.business_model %}
          {% for bullet in narrative.business_model[:4] %}
          <li>{{ bullet }}</li>
          {% endfor %}
          {% elif bundle.company_framing.revenue_model.note %}
          <li>{{ bundle.company_framing.revenue_model.note }}</li>
          {% else %}
          <li>Not yet assessed in this preview.</li>
          {% endif %}
        </ul>
      </div>
    </div>

    <div class="card">
      <h3 class="block-header">Initial Investment Thesis &amp; Fit</h3>
      <div class="card-body">
        <ul class="bullets">
          {% if narrative and narrative.investment_thesis and narrative.investment_thesis.value_drivers %}
          {% if narrative.investment_thesis.why_special %}
          <li><strong>{{ narrative.investment_thesis.why_special }}</strong></li>
          {% for bullet in narrative.investment_thesis.value_drivers[:3] %}
          <li>{{ bullet }}</li>
          {% endfor %}
          {% else %}
          {% for bullet in narrative.investment_thesis.value_drivers[:4] %}
          <li>{{ bullet }}</li>
          {% endfor %}
          {% endif %}
          {% else %}
          {% for bullet in (bundle.executive.thesis_bullets or bundle.company_framing.thesis.bullets or [])[:4] %}
          <li>{{ bullet }}</li>
          {% else %}
          <li>Not yet assessed in this preview.</li>
          {% endfor %}
          {% endif %}
        </ul>
      </div>
    </div>

    <div class="card">
      <h3 class="block-header watchouts">Key Watchouts / Areas to Prove</h3>
      <div class="card-body">
        <ul class="bullets">
          {% for watchout in (narrative.key_watchouts if (narrative and narrative.key_watchouts) else (bundle.executive.key_watchouts or []))[:3] %}
          <li>{{ watchout }}</li>
          {% else %}
          <li>Not yet assessed in this preview.</li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>

  {% set recommendation = (narrative.recommendation if (narrative and narrative.recommendation) else bundle.executive.preliminary_view.closing) %}
  {% if recommendation %}
  <div class="recommendation">{{ recommendation }}</div>
  {% endif %}

  <div class="footer">Proprietary &amp; Confidential — Not for distribution</div>
</section>

<!-- Financial Performance / Revenue Quality / Diligence Priorities -->
<section class="page financials">
  <div class="running-header">
    <span class="company">{{ rainmaker.metadata.company_name | default('', true) }}</span>
    <span>Business Opportunity Summary</span>
  </div>

  <div class="eyebrow">Financial Performance · Revenue Quality · Diligence Priorities</div>
  <h2 class="section-header">The numbers, the customer base, and what to test first</h2>
  <div class="divider"></div>

  {% if rainmaker.financials.periods %}
  {% set has_growth_col = rainmaker.financials.growth_col_label is not none %}
  {% set periods_width = 64 if has_growth_col else 82 %}
  {% set period_col_pct = (periods_width / rainmaker.financials.periods | length) | round(2) %}
  <table class="data-table">
    <thead>
      <tr>
        <th style="width: 18%;">({{ rainmaker.financials.currency }}{{ ' ' ~ rainmaker.financials.unit_label if rainmaker.financials.unit_label }})</th>
        {% for period in rainmaker.financials.periods %}<th style="width: {{ period_col_pct }}%;">{{ period }}</th>{% endfor %}
        {% if has_growth_col %}<th class="growth-col" style="width: 18%;">{{ rainmaker.financials.growth_col_label }}</th>{% endif %}
      </tr>
    </thead>
    <tbody>
      {% for row in rainmaker.financials.rows %}
      <tr {% if row.is_highlighted %}class="highlight"{% endif %}>
        <td>{{ row.metric_name }}</td>
        {% for val in row.cells %}<td>{{ val if val is not none else '–' }}</td>{% endfor %}
        {% if has_growth_col %}<td class="growth-col">{{ row.growth if row.growth is not none else '–' }}</td>{% endif %}
      </tr>
      {% endfor %}
    </tbody>
  </table>

  {% if rainmaker.rule_of_x %}
  <div class="rule-band">
    {% for tile in rainmaker.rule_of_x %}
    <div class="rule-band-tile {{ tile.benchmark }}">
      <span class="value">{{ tile.label }}</span>
      <span class="components">{{ tile.components }}</span>
      <span class="label">{{ tile.period_label }}</span>
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {% else %}
  <p><em>Financial figures not yet extracted from the data room for this preview.</em></p>
  {% endif %}

  {% if rainmaker.key_metrics %}
  <div class="tile-row tile-row-secondary">
    {% for tile in rainmaker.key_metrics %}
    <div class="tile">
      <span class="value">{{ tile.value }}</span>
      <span class="label">{{ tile.label }}</span>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <div class="two-col">
    <div>
      <h3 class="block-header">Revenue Quality &amp; Customer Base</h3>
      <ul class="bullets">
        {% if narrative and narrative.commercial_revenue_quality %}
        {% for item in narrative.commercial_revenue_quality[:5] %}
        <li><strong>{{ item.topic }}:</strong> {{ item.detail }}</li>
        {% endfor %}
        {% else %}
        {% if bundle.revenue_quality.concentration %}<li>{{ bundle.revenue_quality.concentration }}</li>{% endif %}
        {% if bundle.revenue_quality.retention_notes %}<li>{{ bundle.revenue_quality.retention_notes }}</li>{% endif %}
        {% if bundle.revenue_quality.end_market_mix %}<li>{{ bundle.revenue_quality.end_market_mix }}</li>{% endif %}
        {% if not (bundle.revenue_quality.concentration or bundle.revenue_quality.retention_notes or bundle.revenue_quality.end_market_mix) %}
        <li>Not yet assessed in this preview.</li>
        {% endif %}
        {% endif %}
      </ul>
    </div>
    <div>
      <h3 class="block-header">Priority Diligence Questions</h3>
      <ul class="bullets">
        {% if narrative and narrative.diligence_priorities %}
        {% for q in narrative.diligence_priorities[:6] %}
        <li>{{ q }}</li>
        {% endfor %}
        {% else %}
        {% for q in (rainmaker.diligence_questions or [])[:6] %}
        <li><strong>{{ q.category | default('', true) | title }}:</strong> {{ q.question | default('', true) }}</li>
        {% else %}
        <li>Not yet assessed in this preview.</li>
        {% endfor %}
        {% endif %}
      </ul>
    </div>
  </div>

  <div class="footer">
    Proprietary &amp; Confidential — Not for distribution
    <span class="disclosure">{{ rainmaker.metadata.status }} Synthesized from the available data room; figures are management-reported and unverified.</span>
  </div>
</section>

<!-- Minimum Pursuit Score — the verdict on the argument built by the prior two pages -->
<section class="page mps">
  <div class="running-header">
    <span class="company">{{ rainmaker.metadata.company_name | default('', true) }}</span>
    <span>Business Opportunity Summary</span>
  </div>

  <div class="eyebrow">Minimum Pursuit Score</div>
  <h2 class="section-header">Does this clear Rallyday's bar for further pursuit?</h2>
  <div class="divider"></div>

  {% set mps_score_col_pct = (16 / mps.columns | length) | round(2) if mps.columns else 0 %}
  <table class="mps-table">
    <thead>
      <tr>
        <th class="mps-category-col" style="width: 15%;"></th>
        {% for col in mps.columns %}<th class="mps-score-col" style="width: {{ mps_score_col_pct }}%;">{{ col.header }}</th>{% endfor %}
        <th>Commentary</th>
      </tr>
    </thead>
    <tbody>
      {% for row in mps.rows %}
      <tr>
        <td class="mps-category-col">
          {{ row.display_name }}{% if row.evidence_marker %}<sup>{{ row.evidence_marker }}</sup>{% endif %}
        </td>
        {% for cell in row.score_cells %}<td class="mps-score-col">{{ cell if cell is not none else '—' }}</td>{% endfor %}
        <td class="mps-commentary-col">
          {% if row.bullets %}
          <ul class="bullets">
            {% for bullet in row.bullets %}
            <li{% if bullet.kind == 'counter_evidence' %} class="mps-counter-evidence"{% endif %}>{% if bullet.axis %}<strong>{{ bullet.axis }}:</strong> {% endif %}{{ bullet.text }}</li>
            {% endfor %}
          </ul>
          {% else %}
          <ul class="bullets"><li>Not yet assessed in this preview.</li></ul>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
      <tr class="mps-total-row">
        <td class="mps-category-col"><strong>Total</strong></td>
        {% for cell in mps.total_cells %}<td class="mps-score-col">{{ cell if cell is not none else '—' }}</td>{% endfor %}
        <td class="mps-commentary-col"></td>
      </tr>
    </tbody>
  </table>

  {% if mps.show_legend %}
  <p class="mps-legend">◇ assessed from proxies and judgment; not directly evidenced in the data room</p>
  {% endif %}

  {% if mps.mps_status == "degraded" %}
  <div class="mps-footer-note">Not yet assessed in this preview.</div>
  {% elif mps.verdict is none %}
  <div class="mps-footer-note">Total not computable — {{ mps.n_scored }} of 7 categories scored.</div>
  {% else %}
  <div class="mps-footer-note">Threshold {{ mps.threshold }} · {{ mps.verdict }}</div>
  {% endif %}

  <div class="footer">Proprietary &amp; Confidential — Not for distribution</div>
</section>

</body>
</html>
